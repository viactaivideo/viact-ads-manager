# ---------------------------------------------------------------------------
# viAct Google Ads API credentials
# Copy to `.env` and fill in. NEVER commit the filled-in .env file.
# See docs/SETUP.md for how to obtain each value.
# ---------------------------------------------------------------------------

# 1. Developer token from your MCC:
#    Google Ads (MCC) > Tools > Setup > API Center
GOOGLE_ADS_DEVELOPER_TOKEN=

# 2. OAuth2 client credentials from Google Cloud Console:
#    APIs & Services > Credentials > Create Credentials > OAuth client ID
#    Application type: "Desktop app"
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# 3. Refresh token — generate with: uv run python scripts/get_refresh_token.py
GOOGLE_ADS_REFRESH_TOKEN=

# 4. Your MCC (manager) account ID, digits only, no dashes.
#    Sent as the `login-customer-id` header on every request.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# 5. Optional: the client account queried when a tool call omits customer_id.
#    Digits only, no dashes. Leave blank to always pass it explicitly.
GOOGLE_ADS_CUSTOMER_ID=

# 6. Optional: pin the API version. Defaults to v25.
# GOOGLE_ADS_API_VERSION=v25
