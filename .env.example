# ---------------------------------------------------------------------------
# viAct Google Ads API credentials
# Copy to `.env` and fill in. NEVER commit the filled-in .env file.
# See docs/SETUP.md for how to obtain each value.
# ---------------------------------------------------------------------------

# 1. Developer token from your MCC:
#    Google Ads (MCC) > Tools > Setup > API Center
GOOGLE_ADS_DEVELOPER_TOKEN=

# 2. OAuth2 client credentials from Google Cloud Console:
#    APIs & Services > Credentials > Create Credentials > OAuth client ID
#    Application type: "Desktop app"
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# 3. Refresh token — generate with: uv run python scripts/get_refresh_token.py
GOOGLE_ADS_REFRESH_TOKEN=

# 4. Your MCC (manager) account ID, digits only, no dashes.
#    Sent as the `login-customer-id` header on every request.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# 5. Optional: the client account queried when a tool call omits customer_id.
#    Digits only, no dashes. Leave blank to always pass it explicitly.
GOOGLE_ADS_CUSTOMER_ID=

# 6. Optional: pin the API version. Defaults to v25.
# GOOGLE_ADS_API_VERSION=v25

# ---------------------------------------------------------------------------
# Google Analytics 4 and Tag Manager
# No developer token needed — that is a Google Ads requirement only. These use
# the same OAuth client and refresh token, which must be minted with every
# scope at once: adwords, analytics.readonly, analytics.edit,
# tagmanager.readonly, tagmanager.edit.containers, tagmanager.publish.
# ---------------------------------------------------------------------------

# GA4 > Admin > Property details, top right. Digits only.
GA4_PROPERTY_ID=

# From the Tag Manager URL, after /accounts/
GTM_ACCOUNT_ID=

# Either the numeric ID from the URL after /containers/, or the GTM-XXXX
# public ID from the website snippet — both are accepted.
GTM_CONTAINER_ID=

# ---------------------------------------------------------------------------
# Pipedrive - CRM side of the offline conversion bridge
# Settings > Personal preferences > API. API v2 sends this as an
# x-api-token header; it must never appear in a URL.
# ---------------------------------------------------------------------------

PIPEDRIVE_API_TOKEN=

# Optional: your company domain, e.g. https://viact.pipedrive.com
# Defaults to https://api.pipedrive.com
# PIPEDRIVE_HOST=

# The Google Ads conversion action the bridge uploads into.
# Created 19 Aug 2026 as "Pipedrive Qualified Lead".
PD_CONVERSION_ACTION_ID=7726452125
